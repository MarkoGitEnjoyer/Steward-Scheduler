@page "/steward-schedule"
@using Scheduler.UI.Controllers
@using Scheduler.UI.Models
@inject StewardController StewardController
@inject NavigationManager NavigationManager

<PageTitle>Steward Schedule - Scheduler Steward</PageTitle>

<h1>Steward Schedule</h1>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Select Steward and Week</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="stewardSelect" class="form-label">Select Steward:</label>
                    <div class="input-group">
                        <button class="btn btn-outline-secondary"
                                @onclick="PreviousSteward"
                                disabled="@(model.AvailableStewards.Count == 0 || model.IsLoading)">
                            <i class="oi oi-chevron-left"></i>
                        </button>
                        <select class="form-select" id="stewardSelect" @bind="selectedStewardId">
                            <option value="0">-- Select a Steward --</option>
                            @foreach (var steward in model.AvailableStewards)
                            {
                                <option value="@steward.StewardId">@steward.FirstName @steward.LastName (@steward.Role)</option>
                            }
                        </select>
                        <button class="btn btn-outline-secondary"
                                @onclick="NextSteward"
                                disabled="@(model.AvailableStewards.Count == 0 || model.IsLoading)">
                            <i class="oi oi-chevron-right"></i>
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="weekSelect" class="form-label">Select Week:</label>
                    <div class="input-group">
                        <input type="date" class="form-control" id="weekSelect" @bind="selectedDate" />
                        <button class="btn btn-outline-secondary" @onclick="CurrentWeek">Current</button>
                    </div>
                </div>

                <div class="d-grid">
                    <button class="btn btn-primary"
                            @onclick="LoadStewardSchedule"
                            disabled="@(selectedStewardId == 0 || model.IsLoading)">
                        @if (model.IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span> Loading...</span>
                        }
                        else
                        {
                            <span>View Schedule</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        @if (model.SelectedSteward != null)
        {
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Steward Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <h4>@model.SelectedSteward.FirstName @model.SelectedSteward.LastName</h4>
                            <p class="mb-1">
                                <strong>Role:</strong> @model.SelectedSteward.Role
                                @if (model.SelectedSteward.IsSenior)
                                {
                                    <span class="badge bg-danger ms-2">Senior</span>
                                }
                            </p>
                            <p class="mb-1"><strong>ID:</strong> @model.SelectedSteward.StewardId</p>
                            <p class="mb-1"><strong>Joined:</strong> @model.SelectedSteward.JoiningDate.ToString("d")</p>
                            <p class="mb-1">
                                <strong>Experience:</strong>
                                @(Math.Round(model.SelectedSteward.ExperienceYears, 1)) years
                            </p>
                            <p class="mb-1">
                                <strong>Current Month Hours:</strong>
                                @model.SelectedSteward.MonthlyHours / 90 hours
                            </p>
                            <p class="mb-1">
                                <strong>Feedback Rating:</strong>
                                @(model.SelectedSteward.PositiveFeedbackCount - model.SelectedSteward.NegativeFeedbackCount)
                                (@model.SelectedSteward.PositiveFeedbackCount positive, @model.SelectedSteward.NegativeFeedbackCount negative)
                            </p>
                        </div>
                        <div class="col-md-4">
                            <div class="progress mb-2" style="height: 20px;">
                                <div class="progress-bar"
                                     role="progressbar"
                                     style="width: @(Math.Min(100, model.SelectedSteward.MonthlyHours / 90 * 100))%;"
                                     aria-valuenow="@model.SelectedSteward.MonthlyHours"
                                     aria-valuemin="0"
                                     aria-valuemax="90">
                                    @model.SelectedSteward.MonthlyHours hrs
                                </div>
                            </div>
                            <div class="mt-3">
                                <h6>Languages:</h6>
                                <div>
                                    @foreach (var language in model.SelectedSteward.Languages)
                                    {
                                        <span class="badge bg-primary me-1 mb-1">@language</span>
                                    }
                                    @if (!model.SelectedSteward.Languages.Any())
                                    {
                                        <span class="text-muted">No language data</span>
                                    }
                                </div>
                            </div>
                            <div class="mt-3">
                                <h6>Aircraft Licenses:</h6>
                                <div>
                                    @foreach (var license in model.SelectedSteward.Licenses)
                                    {
                                        <span class="badge bg-success me-1 mb-1">@license</span>
                                    }
                                    @if (!model.SelectedSteward.Licenses.Any())
                                    {
                                        <span class="text-muted">No license data</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (model.ScheduledFlights.Any())
{
    <div class="card">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Schedule for Week: @model.FormattedWeekRange</h5>
            <span class="badge bg-light text-dark">@model.ScheduledFlights.Count Flights</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Day</th>
                            <th>Flight #</th>
                            <th>Departure</th>
                            <th>Arrival</th>
                            <th>Destination</th>
                            <th>Aircraft</th>
                            <th>Flight Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var flight in model.ScheduledFlights.OrderBy(f => f.DepartureTime))
                        {
                            <tr>
                                <td>@flight.DepartureTime.ToString("ddd, MMM d")</td>
                                <td>@flight.FlightNumber</td>
                                <td>@flight.DepartureTime.ToString("HH:mm")</td>
                                <td>@flight.ArrivalTime.ToString("HH:mm")</td>
                                <td>@flight.Destination</td>
                                <td>@flight.AircraftType</td>
                                <td>@flight.FlightTime hrs</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Weekly Schedule View</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th style="width: 12%">Time</th>
                                    @for (int i = 0; i < 7; i++)
                                    {
                                        var day = model.WeekStart.AddDays(i);
                                        <th style="width: 12%">@day.ToString("ddd, MMM d")</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (int hour = 0; hour < 24; hour++)
                                {
                                    <tr>
                                        <td class="text-center">@($"{hour:00}:00")</td>
                                        @for (int day = 0; day < 7; day++)
                                        {
                                            var currentDay = model.WeekStart.AddDays(day);
                                            var startHour = new DateTime(currentDay.Year, currentDay.Month, currentDay.Day, hour, 0, 0);
                                            var endHour = startHour.AddHours(1);

                                            var flightsInHour = model.ScheduledFlights.Where(f =>
                                            (f.DepartureTime >= startHour && f.DepartureTime < endHour) ||
                                            (f.DepartureTime < startHour && f.ArrivalTime > startHour)).ToList();

                                            <td>
                                                @foreach (var flight in flightsInHour)
                                                {
                                                    var isStartHour = flight.DepartureTime.Hour == hour &&
                                                    flight.DepartureTime.Day == currentDay.Day;

                                                    <div class="flight-block @(isStartHour ? "flight-departure" : "flight-ongoing")">
                                                        @if (isStartHour)
                                                        {
                                                            <div class="flight-time">@flight.DepartureTime.ToString("HH:mm")</div>
                                                            <div class="flight-number">@flight.FlightNumber</div>
                                                            <div class="flight-destination">to @flight.Destination</div>
                                                        }
                                                        else
                                                        {
                                                            <div class="flight-in-progress">In Flight: @flight.FlightNumber</div>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (!model.IsLoading && selectedStewardId > 0)
{
    <div class="alert alert-info mt-4">
        <h4><i class="oi oi-info"></i> No Flights Scheduled</h4>
        <p>There are no flights scheduled for this steward in the selected week.</p>
    </div>
}

@if (!string.IsNullOrEmpty(model.ErrorMessage))
{
    <div class="alert alert-danger mt-3">
        <h4><i class="oi oi-warning"></i> Error</h4>
        <p>@model.ErrorMessage</p>
    </div>
}

<style>
    .flight-block {
        padding: 4px 8px;
        border-radius: 4px;
        margin-bottom: 4px;
        font-size: 0.8rem;
    }

    .flight-departure {
        background-color: #d1e7ff;
        border-left: 4px solid #0d6efd;
    }

    .flight-ongoing {
        background-color: #e9ecef;
        border-left: 4px solid #6c757d;
    }

    .flight-time {
        font-weight: bold;
    }

    .flight-number {
        font-size: 0.75rem;
    }

    .flight-destination {
        font-size: 0.75rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .flight-in-progress {
        font-style: italic;
        font-size: 0.75rem;
    }
</style>

@code {
    private int selectedStewardId = 0;
    private DateTime selectedDate = new DateTime(2025, 2, 17);
    private StewardScheduleViewModel model = new StewardScheduleViewModel();

    protected override async Task OnInitializedAsync()
    {
        AdjustSelectedDateToMonday();
        await LoadStewardList();
    }

    private async Task LoadStewardList()
    {
        // Just load the list of stewards without a specific schedule
        model = await StewardController.GetStewardScheduleAsync(0, selectedDate);
    }

    private void AdjustSelectedDateToMonday()
    {
        int daysUntilMonday = ((int)selectedDate.DayOfWeek - 1 + 7) % 7;
        selectedDate = selectedDate.AddDays(-daysUntilMonday);
    }

    private void CurrentWeek()
    {
        selectedDate = new DateTime(2025, 2, 17);
        AdjustSelectedDateToMonday();
    }

    private async Task NextSteward()
    {
        if (model.AvailableStewards.Count == 0 || model.IsLoading)
            return;

        // Find the current index
        int currentIndex = model.AvailableStewards.FindIndex(s => s.StewardId == selectedStewardId);

        // If not found or at the end, go to the first steward
        if (currentIndex == -1 || currentIndex == model.AvailableStewards.Count - 1)
            selectedStewardId = model.AvailableStewards.First().StewardId;
        else
            selectedStewardId = model.AvailableStewards[currentIndex + 1].StewardId;

        await LoadStewardSchedule();
    }

    private async Task PreviousSteward()
    {
        if (model.AvailableStewards.Count == 0 || model.IsLoading)
            return;

        // Find the current index
        int currentIndex = model.AvailableStewards.FindIndex(s => s.StewardId == selectedStewardId);

        // If not found or at the beginning, go to the last steward
        if (currentIndex <= 0)
            selectedStewardId = model.AvailableStewards.Last().StewardId;
        else
            selectedStewardId = model.AvailableStewards[currentIndex - 1].StewardId;

        await LoadStewardSchedule();
    }

    private async Task LoadStewardSchedule()
    {
        if (selectedStewardId <= 0)
            return;

        // Load the steward's schedule via the controller
        model = await StewardController.GetStewardScheduleAsync(selectedStewardId, selectedDate);
    }
}