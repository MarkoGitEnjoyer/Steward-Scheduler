@page "/view-schedule"
@using Scheduler.UI.Controllers
@using Scheduler.UI.Models
@inject ScheduleController ScheduleController

<PageTitle>View Schedule - Scheduler Steward</PageTitle>

<h1>Weekly Flight Schedule</h1>

<div class="row mb-3">
    <div class="col-md-4">
        <div class="input-group">
            <span class="input-group-text">Week Starting</span>
            <input type="date" class="form-control" @bind="selectedDate" />
            <button class="btn btn-primary" @onclick="LoadSchedule">Load</button>
        </div>
    </div>
    
    <div class="col-md-8 text-end">
        <div class="btn-group">
            <button class="btn btn-outline-primary" @onclick="PreviousWeek">
                <span class="oi oi-arrow-left"></span> Previous Week
            </button>
            <button class="btn btn-outline-secondary" @onclick="CurrentWeek">
                Current Week
            </button>
            <button class="btn btn-outline-primary" @onclick="NextWeek">
                Next Week <span class="oi oi-arrow-right"></span>
            </button>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Schedule: @model.FormattedWeekRange</h5>
        <div>
            <span class="badge bg-info">Fitness Score: @(Math.Round(model.FitnessScore * 100, 1))%</span>
        </div>
    </div>
    <div class="card-body">
        @if (model.IsLoading)
        {
            <div class="text-center p-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading schedule...</p>
            </div>
        }
        else if (!model.FlightAssignments.Any())
        {
            <div class="alert alert-warning">
                <h4><i class="oi oi-warning"></i> No Schedule Found</h4>
                <p>There is no schedule available for the selected week.</p>
                <a href="/generate-schedule" class="btn btn-primary">Generate Schedule</a>
            </div>
        }
        else
        {
            <div class="mb-3">
                <div class="btn-group">
                    <button class="btn @(viewMode == "day" ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => viewMode = vday">
                        Day View
                    </button>
                    <button class="btn @(viewMode == "week" ? "btn-primary" : "btn-outline-primary")" 
                            @onclick="() => viewMode = vweek">
                        Week View
                    </button>
                    <button class="btn @(viewMode == "list" ? "btn-primary" : "btn-outline-primary")" 
                            @onclick="() => viewMode = vlist">
                        List View
                    </button>
                </div>
            </div>
            
            @if (viewMode == "day")
            {
                <div class="row mb-3">
                    <div class="col">
                        <div class="btn-group w-100">
                            @for (int i = 0; i < 7; i++)
                            {
                                var day = model.WeekStart.AddDays(i);
                                var isActive = selectedDay.Date == day.Date;
                                int dayIndex = i; // Capture for lambda
                                
                                <button class="btn @(isActive ? "btn-primary" : "btn-outline-primary")"
                                        @onclick="() => SelectDay(dayIndex)">
                                    @day.ToString("ddd")<br />
                                    @day.ToString("MMM dd")
                                </button>
                            }
                        </div>
                    </div>
                </div>
                
                <h4>Flights on @selectedDay.ToString("dddd, MMMM d, yyyy")</h4>
                
                
                    var flightsForDay = model.FlightAssignments
                        .Where(fa => fa.Flight.DepartureTime.Date == selectedDay.Date)
                        .ToList();
                
                
                @if (flightsForDay.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Flight #</th>
                                    <th>Destination</th>
                                    <th>Aircraft</th>
                                    <th>Duration</th>
                                    <th>Business Class</th>
                                    <th>Economy Class</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var flight in flightsForDay.OrderBy(f => f.Flight.DepartureTime))
                                {
                                    <tr>
                                        <td>
                                            @flight.Flight.DepartureTime.ToString("HH:mm") -
                                            @flight.Flight.ArrivalTime.ToString("HH:mm")
                                        </td>
                                        <td>@flight.Flight.FlightNumber</td>
                                        <td>@flight.Flight.Destination</td>
                                        <td>@flight.Flight.AircraftType</td>
                                        <td>@flight.Flight.FlightTime hours</td>
                                        <td>
                                            @if (flight.BusinessStewards.Any())
                                            {
                                                <div class="crew-list">
                                                    @foreach (var steward in flight.BusinessStewards)
                                                    {
                                                        <div class="crew-member">
                                                            <i class="oi oi-person"></i> @steward.FullName
                                                            @if (steward.IsSenior)
                                                            {
                                                                <span class="badge bg-danger ms-1">Senior</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                                <div class="text-muted mt-1">
                                                    @flight.BusinessStewards.Count/@flight.Flight.RequiredBusinessCrew assigned
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-danger">Not assigned</span>
                                            }
                                        </td>
                                        <td>
                                            @if (flight.EconomyStewards.Any())
                                            {
                                                <div class="crew-list">
                                                    @foreach (var steward in flight.EconomyStewards)
                                                    {
                                                        <div class="crew-member">
                                                            <i class="oi oi-person"></i> @steward.FullName
                                                        </div>
                                                    }
                                                </div>
                                                <div class="text-muted mt-1">
                                                    @flight.EconomyStewards.Count/@flight.Flight.RequiredEconomyCrew assigned
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-danger">Not assigned</span>
                                            }
                                        </td>
                                        <td>
                                            @if (flight.IsComplete)
                                            {
                                                <span class="badge bg-success">Complete</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Incomplete</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <h5><i class="oi oi-info"></i> No Flights</h5>
                        <p>There are no flights scheduled for this day.</p>
                    </div>
                }
            }
            else if (viewMode == "week")
            {
                <div class="week-calendar">
                    <div class="day-header">
                        <div class="time-column"></div>
                        @for (int i = 0; i < 7; i++)
                        {
                            var day = model.WeekStart.AddDays(i);
                            <div class="day-column">
                                <div class="day-name">@day.ToString("ddd")</div>
                                <div class="day-date">@day.ToString("MMM dd")</div>
                            </div>
                        }
                    </div>

                    <div class="time-slots">
                        @for (int hour = 0; hour < 24; hour++)
                        {
                            <div class="time-slot">
                                <div class="time-label">@($"{hour:00}:00")</div>
                                @for (int day = 0; day < 7; day++)
                                {
                                    <div class="day-slot">
                                        @{
                                            var currentDay = model.WeekStart.AddDays(day);
                                            var slotStart = new DateTime(currentDay.Year, currentDay.Month, currentDay.Day, hour, 0, 0);
                                            var slotEnd = slotStart.AddHours(1);

                                            var flightsInSlot = model.FlightAssignments
                                                .Where(fa =>
                                                    (fa.Flight.DepartureTime >= slotStart && fa.Flight.DepartureTime < slotEnd) ||
                                                    (fa.Flight.DepartureTime < slotStart && fa.Flight.ArrivalTime > slotStart))
                                                .ToList();

                                            foreach (var flight in flightsInSlot)
                                            {
                                                var isStart = flight.Flight.DepartureTime >= slotStart && flight.Flight.DepartureTime < slotEnd;

                                                <div class="flight-event @(flight.IsComplete ? "complete" : "incomplete") @(isStart ? "flight-start" : "")">
                                                    @if (isStart)
                                                    {
                                                        <div class="flight-time">@flight.Flight.DepartureTime.ToString("HH:mm")</div>
                                                        <div class="flight-title">@flight.Flight.FlightNumber</div>
                                                        <div class="flight-details">@flight.Flight.Destination</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="in-flight-indicator">
                                                            <i class="oi oi-arrow-right"></i> @flight.Flight.FlightNumber
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                
                <style>
                    .week-calendar {
                        display: flex;
                        flex-direction: column;
                        border: 1px solid #ddd;
                        border-radius: 0.25rem;
                        margin-top: 1rem;
                    }

                    .day-header {
                        display: flex;
                        background-color: #f8f9fa;
                        border-bottom: 1px solid #ddd;
                    }

                    .time-column {
                        width: 60px;
                        border-right: 1px solid #ddd;
                    }

                    .day-column {
                        flex: 1;
                        text-align: center;
                        padding: 8px 4px;
                        border-right: 1px solid #ddd;
                    }

                    .day-column:last-child {
                        border-right: none;
                    }

                    .day-name {
                        font-weight: bold;
                    }

                    .day-date {
                        font-size: 0.8rem;
                        color: #6c757d;
                    }

                    .time-slots {
                        display: flex;
                        flex-direction: column;
                    }

                    .time-slot {
                        display: flex;
                        min-height: 60px;
                        border-bottom: 1px solid #eee;
                    }

                    .time-slot:last-child {
                        border-bottom: none;
                    }

                    .time-label {
                        width: 60px;
                        padding: 4px;
                        text-align: center;
                        font-size: 0.8rem;
                        color: #6c757d;
                        border-right: 1px solid #ddd;
                    }

                    .day-slot {
                        flex: 1;
                        padding: 4px;
                        border-right: 1px solid #eee;
                        position: relative;
                    }

                    .day-slot:last-child {
                        border-right: none;
                    }

                    .flight-event {
                        padding: 4px;
                        margin-bottom: 2px;
                        border-radius: 4px;
                        font-size: 0.8rem;
                        overflow: hidden;
                    }

                    .flight-start {
                        border-left: 4px solid #0d6efd;
                    }

                    .complete {
                        background-color: #d1e7dd;
                    }

                    .incomplete {
                        background-color: #fff3cd;
                    }

                    .flight-time {
                        font-weight: bold;
                    }

                    .flight-title {
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                    }

                    .flight-details {
                        font-size: 0.75rem;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                    }

                    .in-flight-indicator {
                        font-style: italic;
                        color: #6c757d;
                    }
                </style>
            }
            else // list view
            {
                <div class="mb-3">
                    <div class="input-group">
                        <span class="input-group-text">Filter</span>
                        <input type="text" class="form-control" placeholder="Flight number, destination, aircraft..." 
                               @bind="filterText" @bind:event="oninput" />
                    </div>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>
                                    <button class="btn btn-sm btn-link" @onclick="@(() => SortBy("flightNumber"))">
                                        Flight #
                                        <SortIndicator Field="flightNumber" CurrentSort="@sortField" Direction="@sortDirection" />
                                    </button>
                                </th>
                                <th>
                                    <button class="btn btn-sm btn-link" @onclick="@(() => SortBy("departure"))">
                                        Departure
                                        <SortIndicator Field="departure" CurrentSort="@sortField" Direction="@sortDirection" />
                                    </button>
                                </th>
                                <th>
                                    <button class="btn btn-sm btn-link" @onclick="@(() => SortBy("destination"))">
                                        Destination
                                        <SortIndicator Field="destination" CurrentSort="@sortField" Direction="@sortDirection" />
                                    </button>
                                </th>
                                <th>
                                    <button class="btn btn-sm btn-link" @onclick="@(() => SortBy("aircraft"))">
                                        Aircraft
                                        <SortIndicator Field="aircraft" CurrentSort="@sortField" Direction="@sortDirection" />
                                    </button>
                                </th>
                                <th>
                                    <button class="btn btn-sm btn-link" @onclick="@(() => SortBy("priority"))">
                                        Priority
                                        <SortIndicator Field="priority" CurrentSort="@sortField" Direction="@sortDirection" />
                                    </button>
                                </th>
                                <th>Crew Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assignment in filteredAndSortedAssignments)
                            {
                                <tr>
                                    <td>@assignment.Flight.FlightNumber</td>
                                    <td>@assignment.Flight.DepartureTime.ToString("g")</td>
                                    <td>@assignment.Flight.Destination</td>
                                    <td>@assignment.Flight.AircraftType</td>
                                    <td>
                                        @for (int i = 0; i < assignment.Flight.Priority; i++)
                                        {
                                            <i class="oi oi-star"></i>
                                        }
                                        @for (int i = assignment.Flight.Priority; i < 5; i++)
                                        {
                                            <i class="oi oi-star text-muted"></i>
                                        }
                                    </td>
                                    <td>
                                        @if (assignment.IsComplete)
                                        {
                                            <span class="badge bg-success">Complete</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Incomplete</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-info" @onclick="() => ShowFlightDetails(assignment)">
                                            <i class="oi oi-info"></i> Details
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        
        @if (!string.IsNullOrEmpty(model.ErrorMessage))
        {
            <div class="alert alert-danger mt-3">
                <strong>Error:</strong> @model.ErrorMessage
            </div>
        }
    </div>
</div>

@if (selectedFlight != null)
{
    <div class="modal fade show" style="display: block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Flight Details: @selectedFlight.Flight.FlightNumber</h5>
                    <button type="button" class="btn-close" @onclick="CloseFlightDetails"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Flight Information</h6>
                            <table class="table">
                                <tr>
                                    <th>Flight Number</th>
                                    <td>@selectedFlight.Flight.FlightNumber</td>
                                </tr>
                                <tr>
                                    <th>Departure</th>
                                    <td>@selectedFlight.Flight.DepartureTime.ToString("f")</td>
                                </tr>
                                <tr>
                                    <th>Arrival</th>
                                    <td>@selectedFlight.Flight.ArrivalTime.ToString("f")</td>
                                </tr>
                                <tr>
                                    <th>Destination</th>
                                    <td>@selectedFlight.Flight.Destination</td>
                                </tr>
                                <tr>
                                    <th>Aircraft</th>
                                    <td>@selectedFlight.Flight.AircraftType</td>
                                </tr>
                                <tr>
                                    <th>Flight Time</th>
                                    <td>@selectedFlight.Flight.FlightTime hours</td>
                                </tr>
                                <tr>
                                    <th>Priority</th>
                                    <td>
                                        @for (int i = 0; i < selectedFlight.Flight.Priority; i++)
                                        {
                                            <i class="oi oi-star"></i>
                                        }
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h6>Assigned Crew</h6>
                            
                            <h6 class="mt-3">Business Class (@selectedFlight.BusinessStewards.Count/@selectedFlight.Flight.RequiredBusinessCrew)</h6>
                            @if (selectedFlight.BusinessStewards.Any())
                            {
                                <ul class="list-group mb-3">
                                    @foreach (var steward in selectedFlight.BusinessStewards)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            @steward.FullName
                                            @if (steward.IsSenior)
                                            {
                                                <span class="badge bg-danger">Senior</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted">No business class stewards assigned</p>
                            }
                            
                            <h6 class="mt-3">Economy Class (@selectedFlight.EconomyStewards.Count/@selectedFlight.Flight.RequiredEconomyCrew)</h6>
                            @if (selectedFlight.EconomyStewards.Any())
                            {
                                <ul class="list-group">
                                    @foreach (var steward in selectedFlight.EconomyStewards)
                                    {
                                        <li class="list-group-item">@steward.FullName</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted">No economy class stewards assigned</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseFlightDetails">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<style>
    .crew-list {
        max-height: 150px;
        overflow-y: auto;
    }

    .crew-member {
        white-space: nowrap;
        margin-bottom: 2px;
    }
</style>

@code {
    private DateTime selectedDate = DateTime.Now;
    private DateTime selectedDay = DateTime.Now;
    private ScheduleViewModel model = new ScheduleViewModel();
    private string viewMode = "list";
    private string filterText = "";
    private string vday = "day";
    private string vweek = "week";
    private string vlist = "list";
    private string sortField = "departure";
    private string sortDirection = "asc";
    private FlightAssignmentViewModel? selectedFlight;
    
    private IEnumerable<FlightAssignmentViewModel> filteredAndSortedAssignments => 
        FilterAndSortAssignments(model.FlightAssignments);

    protected override async Task OnInitializedAsync()
    {
        // Set selected date to current week's Monday
        AdjustSelectedDateToMonday();
        selectedDay = selectedDate;
        
        await LoadSchedule();
    }

    private void AdjustSelectedDateToMonday()
    {
        int daysUntilMonday = ((int)selectedDate.DayOfWeek - 1 + 7) % 7;
        selectedDate = selectedDate.AddDays(-daysUntilMonday);
    }

    private async Task LoadSchedule()
    {
        // Load the schedule for the selected week using the controller
        model = await ScheduleController.GetScheduleForWeekAsync(selectedDate);
        
        // If schedule loaded successfully, set selected day to first day with flights
        if (model.FlightAssignments.Any())
        {
            var firstFlightDay = model.FlightAssignments.OrderBy(fa => fa.Flight.DepartureTime).First().Flight.DepartureTime.Date;
            if (firstFlightDay >= model.WeekStart && firstFlightDay < model.WeekEnd)
            {
                selectedDay = firstFlightDay;
            }
            else
            {
                selectedDay = model.WeekStart;
            }
        }
    }
    
    private void PreviousWeek()
    {
        selectedDate = selectedDate.AddDays(-7);
        selectedDay = selectedDate;
        LoadSchedule();
    }
    
    private void CurrentWeek()
    {
        selectedDate = DateTime.Now;
        AdjustSelectedDateToMonday();
        selectedDay = selectedDate;
        LoadSchedule();
    }
    
    private void NextWeek()
    {
        selectedDate = selectedDate.AddDays(7);
        selectedDay = selectedDate;
        LoadSchedule();
    }
    
    private void SelectDay(int dayIndex)
    {
        selectedDay = model.WeekStart.AddDays(dayIndex);
    }
    
    private void ShowFlightDetails(FlightAssignmentViewModel flight)
    {
        selectedFlight = flight;
    }
    
    private void CloseFlightDetails()
    {
        selectedFlight = null;
    }
    
    private void SortBy(string field)
    {
        if (sortField == field)
        {
            // Toggle sort direction
            sortDirection = sortDirection == "asc" ? "desc" : "asc";
        }
        else
        {
            // New field, set to ascending by default
            sortField = field;
            sortDirection = "asc";
        }
    }
    
    private IEnumerable<FlightAssignmentViewModel> FilterAndSortAssignments(IEnumerable<FlightAssignmentViewModel> assignments)
    {
        // Filter
        if (!string.IsNullOrWhiteSpace(filterText))
        {
            string filter = filterText.Trim().ToLower();
            assignments = assignments.Where(a => 
                a.Flight.FlightNumber.ToLower().Contains(filter) ||
                a.Flight.Destination.ToLower().Contains(filter) ||
                a.Flight.AircraftType.ToLower().Contains(filter));
        }
        
        // Sort
        switch (sortField)
        {
            case "flightNumber":
                assignments = sortDirection == "asc" 
                    ? assignments.OrderBy(a => a.Flight.FlightNumber)
                    : assignments.OrderByDescending(a => a.Flight.FlightNumber);
                break;
                
            case "departure":
                assignments = sortDirection == "asc" 
                    ? assignments.OrderBy(a => a.Flight.DepartureTime)
                    : assignments.OrderByDescending(a => a.Flight.DepartureTime);
                break;
                
            case "destination":
                assignments = sortDirection == "asc" 
                    ? assignments.OrderBy(a => a.Flight.Destination)
                    : assignments.OrderByDescending(a => a.Flight.Destination);
                break;
                
            case "aircraft":
                assignments = sortDirection == "asc" 
                    ? assignments.OrderBy(a => a.Flight.AircraftType)
                    : assignments.OrderByDescending(a => a.Flight.AircraftType);
                break;
                
            case "priority":
                assignments = sortDirection == "asc" 
                    ? assignments.OrderBy(a => a.Flight.Priority)
                    : assignments.OrderByDescending(a => a.Flight.Priority);
                break;
                
            default:
                assignments = assignments.OrderBy(a => a.Flight.DepartureTime);
                break;
        }
        
        return assignments;
    }
}