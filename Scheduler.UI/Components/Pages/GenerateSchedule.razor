@page "/generate-schedule"
@using Scheduler.UI.Controllers
@using Scheduler.UI.Models
@inject ScheduleController ScheduleController
@inject NavigationManager NavigationManager

<PageTitle>Generate Schedule - Scheduler Steward</PageTitle>

<h1>Generate Weekly Schedule</h1>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Schedule Generation Parameters</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="weekSelector" class="form-label">Select Week:</label>
                    <input type="date" class="form-control" id="weekSelector" @bind="model.SelectedDate" />
                    <small class="form-text text-muted">
                        The schedule will be generated starting from the Monday of the selected week.
                    </small>
                </div>

                <div class="d-grid gap-2">
                    <button class="btn btn-primary" @onclick="StartGeneration" disabled="@model.IsLoading">
                        @if (model.IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span> Generating Schedule...</span>
                        }
                        else
                        {
                            <span>Generate Schedule</span>
                        }
                    </button>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(model.ErrorMessage))
        {
            <div class="alert alert-danger mt-3">
                <strong>Error:</strong> @model.ErrorMessage
            </div>
        }

        @if (model.GenerationCompleted)
        {
            <div class="alert alert-success mt-3">
                <h4><i class="oi oi-check"></i> Schedule Generated Successfully!</h4>
                <p>The schedule has been generated successfully.</p>
                <button class="btn btn-success" @onclick="ViewGeneratedSchedule">
                    View Generated Schedule
                </button>
            </div>
        }
    </div>
</div>

@code {
    // View model for this page
    private ScheduleGenerationViewModel model = new ScheduleGenerationViewModel
        {
            SelectedDate = new DateTime(2025, 2, 17),
        };

    // Timer for progress updates
    private System.Threading.Timer? progressTimer;

    protected override void OnInitialized()
    {
        // Ensure selected date is the beginning of a week (Monday)
        AdjustSelectedDateToMonday();

        // Get the current state from the controller
        model = ScheduleController.GetGenerationState();
    }

    private void AdjustSelectedDateToMonday()
    {
        int daysUntilMonday = ((int)model.SelectedDate.DayOfWeek - 1 + 7) % 7;
        model.SelectedDate = model.SelectedDate.AddDays(-daysUntilMonday);
    }

    private async Task StartGeneration()
    {
        // Start the generation process in the controller
        await ScheduleController.StartGenerationAsync(model);

        // Set up a timer to poll for updates
        progressTimer = new System.Threading.Timer(CheckProgress, null, 0, 500);
    }

    private void CheckProgress(object? state)
    {
        // Get the latest state from the controller
        var updatedModel = ScheduleController.GetGenerationState();

        // Update the view model with new values
        model.IsLoading = updatedModel.IsLoading;
        model.ErrorMessage = updatedModel.ErrorMessage;
        model.GenerationCompleted = updatedModel.GenerationCompleted;

        // If generation is complete or errored, stop the timer
        if (!updatedModel.IsLoading)
        {
            progressTimer?.Dispose();
            progressTimer = null;
        }

        // Force UI update
        InvokeAsync(StateHasChanged);
    }

    private void ViewGeneratedSchedule()
    {
        NavigationManager.NavigateTo("/view-schedule");
    }

    public void Dispose()
    {
        progressTimer?.Dispose();
    }
}