@page "/generate-schedule"
@using Scheduler.UI.Controllers
@using Scheduler.UI.Models
@inject ScheduleController ScheduleController
@inject NavigationManager NavigationManager

<PageTitle>Generate Schedule - Scheduler Steward</PageTitle>

<h1>Generate Weekly Schedule</h1>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Schedule Generation Parameters</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="weekSelector" class="form-label">Select Week:</label>
                    <input type="date" class="form-control" id="weekSelector" @bind="model.SelectedDate" />
                    <small class="form-text text-muted">
                        The schedule will be generated starting from the Monday of the selected week.
                    </small>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="overrideExisting" @bind="model.OverrideExisting">
                        <label class="form-check-label" for="overrideExisting">
                            Override existing schedule (if any)
                        </label>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="algorithmSettings" class="form-label">Algorithm Settings:</label>
                    <select class="form-select" id="algorithmSettings" @bind="model.AlgorithmPreset">
                        <option value="balanced">Balanced (Default)</option>
                        <option value="experience">Experience Focused</option>
                        <option value="feedback">Customer Feedback Focused</option>
                        <option value="workload">Workload Balance Focused</option>
                        <option value="language">Language Skills Focused</option>
                    </select>
                </div>

                <div class="d-grid gap-2">
                    <button class="btn btn-primary" @onclick="StartGeneration" disabled="@model.IsLoading">
                        @if (model.IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span> Generating Schedule...</span>
                        }
                        else
                        {
                            <span>Generate Schedule</span>
                        }
                    </button>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(model.ErrorMessage))
        {
            <div class="alert alert-danger mt-3">
                <strong>Error:</strong> @model.ErrorMessage
            </div>
        }
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Generation Process</h5>
            </div>
            <div class="card-body">
                @if (model.IsLoading)
                {
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3">Generating optimal schedule...</p>
                        <div class="progress mt-2">
                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                 role="progressbar"
                                 style="width: @model.GenerationProgress%"
                                 aria-valuenow="@model.GenerationProgress"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                                @model.GenerationProgress%
                            </div>
                        </div>
                        <p class="text-muted mt-2">Current step: @model.CurrentStep</p>
                    </div>
                }
                else if (model.GenerationCompleted)
                {
                    <div class="text-center">
                        <div class="alert alert-success">
                            <h4><i class="oi oi-check"></i> Schedule Generated Successfully!</h4>
                            <p>The schedule has been generated successfully.</p>
                        </div>

                        <div class="d-grid gap-2">
                            <button class="btn btn-success" @onclick="ViewGeneratedSchedule">
                                View Generated Schedule
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center">
                        <i class="oi oi-clock" style="font-size: 3rem;"></i>
                        <h4 class="mt-3">Ready to Generate Schedule</h4>
                        <p class="text-muted">
                            The scheduler will use a genetic algorithm to create an optimized weekly schedule.
                            This process may take a few minutes depending on the number of flights and stewards.
                        </p>
                        <hr />
                        <div class="text-start">
                            <h5>How It Works:</h5>
                            <ol>
                                <li>Initial schedules are created using priority-based assignment with different weight configurations</li>
                                <li>The genetic algorithm optimizes the schedule through evolution over multiple generations</li>
                                <li>The best schedule is selected based on completion rate, workload balance, language matches, and quality matching</li>
                                <li>The final schedule is saved to the database</li>
                            </ol>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    // View model for this page
    private ScheduleGenerationViewModel model = new ScheduleGenerationViewModel
        {
            SelectedDate = DateTime.Now,
            OverrideExisting = true,
            AlgorithmPreset = "balanced"
        };

    // Timer for progress updates
    private System.Threading.Timer? progressTimer;

    protected override void OnInitialized()
    {
        // Ensure selected date is the beginning of a week (Monday)
        AdjustSelectedDateToMonday();

        // Get the current state from the controller
        model = ScheduleController.GetGenerationState();
    }

    private void AdjustSelectedDateToMonday()
    {
        int daysUntilMonday = ((int)model.SelectedDate.DayOfWeek - 1 + 7) % 7;
        model.SelectedDate = model.SelectedDate.AddDays(-daysUntilMonday);
    }

    private async Task StartGeneration()
    {
        // Start the generation process in the controller
        await ScheduleController.StartGenerationAsync(model);

        // Set up a timer to poll for updates
        progressTimer = new System.Threading.Timer(CheckProgress, null, 0, 500);
    }

    private void CheckProgress(object? state)
    {
        // Get the latest state from the controller
        var updatedModel = ScheduleController.GetGenerationState();

        // Update the view model with new values
        model.GenerationProgress = updatedModel.GenerationProgress;
        model.CurrentStep = updatedModel.CurrentStep;
        model.IsLoading = updatedModel.IsLoading;
        model.ErrorMessage = updatedModel.ErrorMessage;
        model.GenerationCompleted = updatedModel.GenerationCompleted;

        // If generation is complete or errored, stop the timer
        if (!updatedModel.IsLoading)
        {
            progressTimer?.Dispose();
            progressTimer = null;
        }

        // Force UI update
        InvokeAsync(StateHasChanged);
    }

    private void ViewGeneratedSchedule()
    {
        NavigationManager.NavigateTo("/view-schedule");
    }

    public void Dispose()
    {
        progressTimer?.Dispose();
    }
}