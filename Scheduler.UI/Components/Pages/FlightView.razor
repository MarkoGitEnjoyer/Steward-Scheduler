@using Scheduler.Core.Models

<div class="flight-card @(Flight.IsComplete() ? "complete" : "incomplete")">
    <div class="flight-header">
        <div class="flight-direction">
            <span class="badge bg-secondary">Flight</span>
        </div>
        <div class="flight-number">@Flight.Flight.FlightNumber</div>
    </div>
    <div class="flight-details">
        <div class="flight-time">
            <div><strong>Departure:</strong> @Flight.Flight.DepartureTime.ToString("ddd, MMM d HH:mm")</div>
            <div><strong>Arrival:</strong> @Flight.Flight.ArrivalTime.ToString("ddd, MMM d HH:mm")</div>
        </div>
        <div class="flight-destination">
            <div><strong>Destination:</strong> @Flight.Flight.Destination</div>
            <div><strong>Aircraft:</strong> @Flight.Flight.AircraftType</div>
        </div>
    </div>
    @if (!IsCompact)
    {
        <div class="crew-details">
            <div class="business-crew">
                <h6>Business Class (@Flight.BusinessStewards.Count/@Flight.Flight.RequiredBusinessCrew)</h6>
                @if (Flight.BusinessStewards.Any())
                {
                    <ul class="crew-list">
                        @foreach (var steward in Flight.BusinessStewards)
                        {
                            <li>
                                @steward.FullName
                                @if (steward.IsSenior)
                                {
                                    <span class="badge bg-danger ms-1">Senior</span>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-danger">Not assigned</div>
                }
            </div>
            <div class="economy-crew">
                <h6>Economy Class (@Flight.EconomyStewards.Count/@Flight.Flight.RequiredEconomyCrew)</h6>
                @if (Flight.EconomyStewards.Any())
                {
                    <ul class="crew-list">
                        @foreach (var steward in Flight.EconomyStewards)
                        {
                            <li>@steward.FullName</li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-danger">Not assigned</div>
                }
            </div>
        </div>
    }
</div>

<style>
    .flight-card {
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        padding: 1rem;
        margin-bottom: 1.5rem;
        flex: 1;
    }

    .flight-card.complete {
        background-color: #d1e7dd;
        border-color: #a3cfbb;
    }

    .flight-card.incomplete {
        background-color: #fff3cd;
        border-color: #ffe69c;
    }

    .flight-card.outbound {
        border-left: 5px solid #0d6efd;
    }

    .flight-card.single {
        border-left: 5px solid #6c757d;
    }

    .flight-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
        border-bottom: 1px solid rgba(0,0,0,0.1);
        padding-bottom: 0.5rem;
    }

    .flight-number {
        font-size: 1.25rem;
        font-weight: bold;
    }

    .flight-details {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .flight-time, .flight-destination {
        flex: 1;
        min-width: 200px;
    }

    .crew-details {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .business-crew, .economy-crew {
        flex: 1;
        min-width: 200px;
    }

    .crew-list {
        list-style: none;
        padding-left: 0;
        margin-bottom: 0;
        font-size: 0.875rem;
    }

    .crew-list li {
        margin-bottom: 0.25rem;
    }

    /* Compact mode styles */
    .compact .flight-card {
        padding: 0.5rem;
    }

    .compact .flight-header {
        margin-bottom: 0.25rem;
        padding-bottom: 0.25rem;
    }

    .compact .flight-number {
        font-size: 1rem;
    }

    .compact .flight-details {
        font-size: 0.875rem;
        margin-bottom: 0.5rem;
    }
</style>

@code {
    [Parameter]
    public FlightAssignment Flight { get; set; }

    [Parameter]
    public bool IsCompact { get; set; } = false;
}