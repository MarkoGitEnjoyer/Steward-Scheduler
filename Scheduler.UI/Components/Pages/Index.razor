@page "/"
@using Scheduler.UI.Controllers
@using Scheduler.UI.Models
@inject DashboardController DashboardController
@inject NavigationManager NavigationManager

<PageTitle>Dashboard - Scheduler Steward</PageTitle>

<h1>Flight Crew Scheduler Dashboard</h1>

@if (model.IsLoading)
{
    <div class="text-center p-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Loading dashboard data...</p>
    </div>
}
else
{
    <div class="row mt-4">
        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">This Week's Flights</h5>
                    <p class="card-text display-4">@model.CurrentWeekFlights</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Assigned Flights</h5>
                    <p class="card-text display-4">@model.AssignedFlights</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Unassigned Flights</h5>
                    <p class="card-text display-4">@(model.CurrentWeekFlights - model.AssignedFlights)</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Active Stewards</h5>
                    <p class="card-text display-4">@model.ActiveStewards</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary" @onclick="@(() => NavigationManager.NavigateTo("/generate-schedule"))">
                            <span class="oi oi-plus"></span> Generate New Schedule
                        </button>
                        <button class="btn btn-success" @onclick="@(() => NavigationManager.NavigateTo("/view-schedule"))">
                            <span class="oi oi-list-rich"></span> View Current Schedule
                        </button>
                        <button class="btn btn-info" @onclick="@(() => NavigationManager.NavigateTo("/steward-schedule"))">
                            <span class="oi oi-person"></span> View Steward Schedule
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Current Schedule Status</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Schedule Completion:</label>
                        <div class="progress">
                            <div class="progress-bar" role="progressbar"
                                 style="width: @(model.ScheduleCompletionPercentage)%;"
                                 aria-valuenow="@model.ScheduleCompletionPercentage"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                                @model.ScheduleCompletionPercentage%
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Schedule Quality:</label>
                        <div class="progress">
                            <div class="progress-bar bg-info" role="progressbar"
                                 style="width: @(model.ScheduleQualityPercentage)%;"
                                 aria-valuenow="@model.ScheduleQualityPercentage"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                                @model.ScheduleQualityPercentage%
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <small class="text-muted">Week: @model.CurrentWeekDisplay</small>
                        <small class="text-muted">Last Updated: @model.LastUpdated.ToString("g")</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Upcoming Flights (Next 24 Hours)</h5>
                </div>
                <div class="card-body">
                    @if (model.UpcomingFlights.Count == 0)
                    {
                        <p>No upcoming flights in the next 24 hours.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Flight #</th>
                                        <th>Departure</th>
                                        <th>Destination</th>
                                        <th>Aircraft</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var flight in model.UpcomingFlights)
                                    {
                                        <tr>
                                            <td>@flight.FlightNumber</td>
                                            <td>@flight.DepartureTime.ToString("g")</td>
                                            <td>@flight.Destination</td>
                                            <td>@flight.AircraftType</td>
                                            <td>
                                                @if (flight.IsFullyAssigned)
                                                {
                                                    <span class="badge bg-success">Ready</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Incomplete</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(model.ErrorMessage))
{
    <div class="alert alert-danger mt-3">
        <h4><i class="oi oi-warning"></i> Error</h4>
        <p>@model.ErrorMessage</p>
    </div>
}

@code {
    private DashboardViewModel model = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        model = await DashboardController.GetDashboardDataAsync();
    }
}